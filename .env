# ═══════════════════════════════════════════════════════════════
# FlowLens — Docker Environment Variables
# ═══════════════════════════════════════════════════════════════

# PostgreSQL
POSTGRES_USER=flowlens
POSTGRES_PASSWORD=flowlens_2026_hackathon
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Service tokens (inter-service auth)
FLOWLENS_SERVICE_TOKEN=flowlens-service-token-dev
FLOWLENS_ANALYTICS_API_KEY=flowlens-analytics-key-dev
FLOWLENS_FINSTA_API_KEY=flowlens-finsta-key-dev
FLOWLENS_SAFECALL_API_KEY=flowlens-safecall-key-dev

# Bank secrets
BANCO_A_SECRET_KEY=banco-a-docker-secret-2026
BANCO_B_SECRET_KEY=banco-b-docker-secret-2026
BANCO_C_SECRET_KEY=banco-c-docker-secret-2026
